# Copy to .env.local and fill in. Never commit the filled copy.
#   cp .env.example .env.local

# ---- extraction providers ----

# Anthropic direct. Used for the quality ceiling (claude-opus-5) that the
# cheap models get measured against.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter. One key for the whole cheap shortlist (Mistral Small 3.2 24B,
# Qwen3 VL 8B Instruct, Qwen3.6-35B-A3B, Qwen3.6 Plus).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Sent as HTTP-Referer / X-Title on OpenRouter calls. Optional, but it's how
# your usage shows up in their dashboard.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=graph-manipulator

# ---- app ----

# Which extractor the web app uses. Set this from eval results, not vibes.
EXTRACTOR_MODEL=claude-opus-5

# ---- rate limiting (needed before the app is publicly reachable) ----
# A server-side key with no limit in front of it is how one scripted loop
# becomes a four-figure bill. Fill these in before you share the URL.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
