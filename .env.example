# Copy to .env and fill in. Never commit the filled copy.
#   cp .env.example .env
#
# The eval harness loads .env via dotenv/config -- NOT .env.local, which dotenv
# ignores. (Next.js reads .env.local natively, so the web app will accept
# either once it exists.)

# ---- extraction ----

# OpenRouter serves every model in the registry, Claude included, so this is
# the only credential the project needs.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Sent as HTTP-Referer / X-Title on OpenRouter calls. Optional, but it's how
# your usage shows up in their dashboard.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=nodify-edgify

# ---- app ----

# Which extractor the web app uses. These come from eval results, not vibes:
# GLM 5.3 Flash matched Opus 5 on extraction quality (0.5 fixes/graph vs 0.8,
# 96% edge F1 vs 97%, better weight accuracy) at 1/43rd the cost -- but lost one
# fixture in twelve to invalid JSON, which Opus never did. So the cheap model
# takes the traffic and the expensive one covers the hole.
# Names are registry keys from src/extract/registry.ts, not OpenRouter slugs.
EXTRACTOR_MODEL=glm-5.3-flash
EXTRACTOR_FALLBACK_MODEL=opus-5

# ---- rate limiting (needed before the app is publicly reachable) ----
# A server-side key with no limit in front of it is how one scripted loop
# becomes a four-figure bill. Fill these in before you share the URL.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
